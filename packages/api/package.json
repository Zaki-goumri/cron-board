{
  "name": "cronboard-api",
  "version": "0.1.0",
  "description": "Framework-agnostic core types and storage interface for CronBoard.",
  "license": "MIT",
  "author": "Zaki Goumri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zaki-goumri/cron-board.git",
    "directory": "packages/api"
  },
  "keywords": ["cronboard", "cron", "scheduler", "nestjs", "dashboard", "monitoring"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsup": "^8.3.0"
  }
}
