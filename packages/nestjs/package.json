{
  "name": "cronboard-nestjs",
  "version": "0.1.0",
  "description": "NestJS module for monitoring and controlling @nestjs/schedule cron jobs via a web dashboard.",
  "license": "MIT",
  "author": "Zaki Goumri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zaki-goumri/cron-board.git",
    "directory": "packages/nestjs"
  },
  "keywords": ["cronboard", "cron", "nestjs", "scheduler", "dashboard", "monitoring", "bull-board", "schedule"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/serve-static": "^4.0.0 || ^5.0.0",
    "@nestjs/websockets": "^10.0.0 || ^11.0.0",
    "@nestjs/platform-socket.io": "^10.0.0 || ^11.0.0",
    "cron": "^4.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0",
    "socket.io": "^4.0.0"
  },
  "dependencies": {
    "cronboard-api": "workspace:*",
    "cronboard-ui": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsup": "^8.3.0",
    "vitest": "^2.1.0"
  }
}
