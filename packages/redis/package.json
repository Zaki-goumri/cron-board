{
  "name": "cronboard-redis",
  "version": "0.1.1",
  "description": "Optional Redis storage adapter for CronBoard execution history.",
  "license": "MIT",
  "author": "Zaki Goumri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zaki-goumri/cron-board.git",
    "directory": "packages/redis"
  },
  "keywords": [
    "cronboard",
    "redis",
    "storage",
    "cron",
    "nestjs"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "cronboard-api": "workspace:^",
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsup": "^8.3.0",
    "ioredis": "^5.4.0"
  },
  "homepage": "https://github.com/Zaki-goumri/cron-board#readme",
  "bugs": {
    "url": "https://github.com/Zaki-goumri/cron-board/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
